{
    "name": "poke-catalog",
    "version": "0.0.2",
    "description": "A Poké Catalog app for managing and viewing a collection of Pokémon related items. Built with Express, EJS, and TypeScript.",
    "author": "josh-tf",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/josh-tf/poke-catalog.git"
    },
    "homepage": "https://github.com/josh-tf/poke-catalog#readme",
    "bugs": {
        "url": "https://github.com/josh-tf/poke-catalog/issues"
    },
    "packageManager": "yarn@4.9.1",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "dev": "nodemon --exec ts-node src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
        "lint": "lint-staged --no-stash --allow-empty --diff=HEAD",
        "lint:fix": "eslint . --ext .ts,.tsx,.js --fix",
        "spell": "cspell \"**/*.{ts,js,md,json}\"",
        "check:unused": "depcheck --specials=typescript"
    },
    "dependencies": {
        "connect-session-sequelize": "^8.0.1",
        "dotenv": "^17.2.0",
        "ejs": "^3.1.10",
        "express": "^5.1.0",
        "express-ejs-layouts": "^2.5.1",
        "express-fileupload": "^1.5.2",
        "express-session": "^1.18.1",
        "passport": "^0.7.0",
        "passport-discord": "^0.1.4",
        "sequelize": "^6.37.7",
        "sqlite3": "^5.1.7"
    },
    "devDependencies": {
        "@types/ejs": "^3",
        "@types/express": "^5.0.3",
        "@types/express-ejs-layouts": "^2",
        "@types/express-fileupload": "^1",
        "@types/express-session": "^1.18.2",
        "@types/node": "^24.0.13",
        "@types/passport": "^0",
        "@types/passport-discord": "^0",
        "@typescript-eslint/eslint-plugin": "^8.36.0",
        "@typescript-eslint/parser": "^8.36.0",
        "cspell": "^9.1.3",
        "depcheck": "^1.4.7",
        "eslint": "^9.31.0",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-html": "^8.1.3",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-prettier": "^5.4.0",
        "eslint-plugin-unused-imports": "^4.1.4",
        "lint-staged": "^16.1.2",
        "nodemon": "^3.1.10",
        "prettier": "^3.6.2",
        "prettier-plugin-ejs": "^1.0.3",
        "prettier-plugin-organize-imports": "^4.1.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.3"
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged"
        }
    },
    "lint-staged": {
        "**/*.{ts,tsx,js}": [
            "prettier --write --config .prettierrc",
            "eslint --fix"
        ],
        "**/*.{json,md}": [
            "prettier --write --config .prettierrc",
            "cspell --config cspell.json --no-color"
        ]
    }
}
