<!DOCTYPE html>
<html>
  <head>
    <title>Poké Catalog</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <body class="p-4">
    <h1 class="mb-4">Poké Catalog</h1>
    <a class="btn btn-primary mb-3" href="/add">➕ Add New Item</a>
    <ul class="list-group">
      <% items.forEach(item => { %>
      <li class="list-group-item">
        <% if (item.images && item.images.length > 0) { %>
        <div class="mb-2 d-flex flex-wrap gap-2">
          <% item.images.forEach(image => { %>
          <img
            src="<%= image %>"
            alt="Card image"
            class="img-thumbnail"
            style="max-height: 150px"
          />
          <% }) %>
        </div>
        <% } %>
        <strong><%= item.title %></strong> — <%= item.desc %>
        <br />
        <small>ID: <%= item.id %>, Flags: <%= item.flags.join(', ') %></small>
        <br />
        <small
          >Paid: $<%= item.pricePaid %>, Market: $<%= item.marketValue %></small
        >
      </li>
      <% }) %>
    </ul>
  </body>
</html>
