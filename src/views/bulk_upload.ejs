<%- include('partials/header', { title: 'Bulk Upload', user }) %>
<h1 class="mb-4">Bulk Upload</h1>
<form method="POST" action="/bulk-add" enctype="multipart/form-data" class="mb-3">
  <div class="mb-2">
    <input class="form-control" type="file" name="images" accept="image/*" multiple required />
  </div>
  <button class="btn btn-success">Next</button>
</form>
<a class="btn btn-secondary" href="/">⬅ Back</a>
<%- include('partials/footer') %>
