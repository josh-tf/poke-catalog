<h1 class="page-title">
    Bulk Upload
</h1>

<form
    method="POST"
    action="/bulk-add"
    enctype="multipart/form-data"
    class="space-y-6 mb-10 font-pixel"
>
    <!-- File Upload -->
    <div>
        <input
            type="file"
            name="images"
            accept="image/*"
            multiple
            required
            class="form-control"
        />
    </div>

    <!-- Submit Button -->
    <div class="flex gap-3">
        <button
            type="submit"
            class="btn btn-primary"
        >
            ⚡ Next
        </button>
        <a
            href="/"
            class="btn btn-primary"
        >
            ⬅ Back
        </a>
    </div>
</form>
