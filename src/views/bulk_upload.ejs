<h1 class="text-3xl font-pixel text-pokemon-psychic mb-6 tracking-wide">
    Bulk Upload
</h1>

<form
    method="POST"
    action="/bulk-add"
    enctype="multipart/form-data"
    class="space-y-6 mb-10 font-pixel"
>
    <!-- File Upload -->
    <div>
        <input
            type="file"
            name="images"
            accept="image/*"
            multiple
            required
            class="w-full border border-gray-300 rounded px-4 py-2 text-sm file:mr-3 file:py-1 file:px-3 file:border file:rounded file:border-gray-300 file:bg-gray-100 file:text-sm file:text-gray-700 hover:file:bg-gray-200"
        />
    </div>

    <!-- Submit Button -->
    <div class="flex gap-3">
        <button
            type="submit"
            class="bg-pokemon-electric hover:bg-pokemon-electric/90 text-black text-sm px-4 py-2 rounded shadow transition"
        >
            ⚡ Next
        </button>
        <a
            href="/"
            class="bg-gray-300 hover:bg-gray-400 text-sm text-gray-800 px-4 py-2 rounded inline-block transition"
        >
            ⬅ Back
        </a>
    </div>
</form>
