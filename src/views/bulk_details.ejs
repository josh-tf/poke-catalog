<h1 class="text-3xl font-pixel text-pokemon-psychic mb-6 tracking-wide">
    Add Details
</h1>

<form method="POST" action="/bulk-add/save" class="space-y-6">
    <% files.forEach((file, idx) => { %>
    <div
        class="bulk-item border-2 border-pokemon-psychic rounded-lg p-4 bg-white shadow-lg font-pixel"
    >
        <!-- Image -->
        <img
            src="/uploads/<%= file.name %>"
            alt="Uploaded image"
            class="w-auto max-h-40 object-contain mb-4 border border-gray-300 rounded bg-gray-50"
        />

        <input type="hidden" name="image" value="/uploads/<%= file.name %>" />

        <!-- ID Field -->
        <div class="mb-3">
            <input
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pokemon-electric id-input"
                name="id"
                placeholder="ID (e.g. sv1v-087)"
            />
            <div class="text-xs text-gray-500 mt-1 id-feedback"></div>
        </div>

        <!-- Title Field -->
        <div class="mb-3">
            <input
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pokemon-fire title-input"
                name="title"
                placeholder="Title"
            />
        </div>

        <!-- Description Field -->
        <div class="mb-3">
            <input
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pokemon-water"
                name="desc"
                placeholder="Description"
            />
        </div>

        <!-- Category Field -->
        <div class="mb-3">
            <select
                name="category"
                required
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-pokemon-grass"
            >
                <% categories.forEach(cat => { %>
                <option value="<%= cat.id %>"><%= cat.label %></option>
                <% }) %>
            </select>
        </div>

        <!-- Price Paid -->
        <div class="mb-3">
            <input
                type="number"
                step="0.01"
                name="pricePaid"
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pokemon-fairy"
                placeholder="Price Paid"
            />
        </div>

        <!-- Market Value -->
        <div>
            <input
                type="number"
                step="0.01"
                name="marketValue"
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pokemon-dragon"
                placeholder="Market Value"
            />
        </div>
    </div>
    <% }) %>

    <!-- Submit & Back -->
    <div class="flex items-center gap-4 mt-4">
        <button
            type="submit"
            class="bg-pokemon-grass hover:bg-pokemon-grass/90 text-white font-pixel px-4 py-2 rounded shadow transition"
        >
            💾 Save All
        </button>
        <a
            href="/"
            class="text-sm text-gray-700 hover:text-gray-900 underline font-pixel"
        >
            ⬅ Back
        </a>
    </div>
</form>

<script src="/form.js"></script>
