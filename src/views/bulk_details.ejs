<!DOCTYPE html>
<html>
  <head>
    <title>Bulk Details</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  </head>
  <body class="p-4">
    <h1 class="mb-4">Add Details</h1>
    <form method="POST" action="/bulk-add/save">
      <% files.forEach((file, idx) => { %>
      <div class="border rounded p-3 mb-3 bulk-item">
        <img src="/uploads/<%= file.filename %>" class="img-thumbnail mb-2" style="max-height:150px" />
        <input type="hidden" name="image" value="/uploads/<%= file.filename %>" />
        <div class="mb-2">
          <input class="form-control id-input" name="id" placeholder="ID" />
          <div class="form-text id-feedback"></div>
        </div>
        <div class="mb-2">
          <input class="form-control title-input" name="title" placeholder="Title" />
        </div>
        <div class="mb-2">
          <input class="form-control" name="desc" placeholder="Description" />
        </div>
        <div class="mb-2">
          <select class="form-select" name="category" required>
            <option value="Cards">Cards</option>
            <option value="Graded">Graded</option>
            <option value="Boosters">Boosters</option>
            <option value="Collection Boxes">Collection Boxes</option>
          </select>
        </div>
        <div class="mb-2">
          <input class="form-control" name="pricePaid" type="number" step="0.01" placeholder="Price Paid" />
        </div>
        <div class="mb-2">
          <input class="form-control" name="marketValue" type="number" step="0.01" placeholder="Market Value" />
        </div>
      </div>
      <% }) %>
      <button class="btn btn-success">Save All</button>
    </form>
    <a class="btn btn-secondary mt-3" href="/">⬅ Back</a>
    <script src="/form.js"></script>
  </body>
</html>
