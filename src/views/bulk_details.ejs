<h1 class="page-title">
    Add Details
</h1>

<form method="POST" action="/bulk-add/save" class="space-y-6">
    <% files.forEach((file, idx) => { %>
    <div
        class="bulk-item border-2 border-pokemon-psychic rounded-lg p-4 bg-white shadow-lg font-pixel"
    >
        <!-- Image -->
        <img
            src="/uploads/<%= file.name %>"
            alt="Uploaded image"
            class="w-auto max-h-40 object-contain mb-4 border border-gray-300 rounded bg-gray-50"
        />

        <input type="hidden" name="image" value="/uploads/<%= file.name %>" />

        <!-- ID Field -->
        <div class="mb-3">
            <input
                class="form-control"
                name="id"
                placeholder="ID (e.g. sv1v-087)"
            />
            <div class="text-xs text-gray-500 mt-1 id-feedback"></div>
        </div>

        <!-- Title Field -->
        <div class="mb-3">
            <input
                class="form-control"
                name="title"
                placeholder="Title"
            />
        </div>

        <!-- Description Field -->
        <div class="mb-3">
            <input
                class="form-control"
                name="desc"
                placeholder="Description"
            />
        </div>

        <!-- Purchase Date -->
        <div class="mb-3">
            <input
                type="date"
                name="purchaseDate"
                class="form-control"
            />
        </div>

        <!-- Condition -->
        <div class="mb-3">
            <select
                name="condition"
                class="form-control"
            >
                <option value="">(condition)</option>
                <option value="mint">Mint</option>
                <option value="used">Used</option>
                <option value="sealed">Sealed</option>
            </select>
        </div>

        <!-- Trade/Sale -->
        <div class="flex gap-4 items-center mb-3">
            <label class="flex items-center gap-2">
                <input type="checkbox" name="forTrade" class="h-4 w-4" /> For Trade
            </label>
            <label class="flex items-center gap-2">
                <input type="checkbox" name="forSale" class="h-4 w-4" /> For Sale
            </label>
        </div>

        <!-- Category Field -->
        <div class="mb-3">
            <select
                name="category"
                required
                class="form-control"
            >
                <% categories.forEach(cat => { %>
                <option value="<%= cat.id %>"><%= cat.label %></option>
                <% }) %>
            </select>
        </div>

        <!-- Subcategory Field -->
        <div class="mb-3">
            <select
                name="subcategory"
                class="form-control"
            >
                <option value="">(none)</option>
                <% categories.forEach(cat => { %>
                    <% if (cat.subcategories) { %>
                        <optgroup label="<%= cat.label %>">
                            <% cat.subcategories.forEach(sub => { %>
                                <option value="<%= sub.id %>"><%= sub.label %></option>
                            <% }) %>
                        </optgroup>
                    <% } %>
                <% }) %>
            </select>
        </div>

        <!-- Price Paid -->
        <div class="mb-3">
            <input
                type="number"
                step="0.01"
                name="pricePaid"
                class="form-control"
                placeholder="Price Paid"
            />
        </div>

        <!-- Market Value -->
        <div>
            <input
                type="number"
                step="0.01"
                name="marketValue"
                class="form-control"
                placeholder="Market Value"
            />
        </div>
    </div>
    <% }) %>

    <!-- Submit & Back -->
    <div class="flex items-center gap-4 mt-4">
        <button
            type="submit"
            class="btn btn-primary"
        >
            💾 Save All
        </button>
        <a
            href="/"
            class="btn btn-primary"
        >
            ⬅ Back
        </a>
    </div>
</form>

<script src="/form.js"></script>
