<h1 class="text-2xl font-bold mb-6">Add Details</h1>

<form method="POST" action="/bulk-add/save" class="space-y-6">
    <% files.forEach((file, idx) => { %>
    <div
        class="bulk-item border border-gray-200 rounded-lg p-4 bg-white shadow-sm"
    >
        <!-- Image -->
        <img
            src="/uploads/<%= file.name %>"
            alt="Uploaded image"
            class="w-auto max-h-40 object-contain mb-4 border rounded"
        />

        <input type="hidden" name="image" value="/uploads/<%= file.name %>" />

        <!-- ID Field -->
        <div class="mb-3">
            <input
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm id-input"
                name="id"
                placeholder="ID (e.g. sv1v-087)"
            />
            <div class="text-xs text-gray-500 mt-1 id-feedback"></div>
        </div>

        <!-- Title Field -->
        <div class="mb-3">
            <input
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm title-input"
                name="title"
                placeholder="Title"
            />
        </div>

        <!-- Description Field -->
        <div class="mb-3">
            <input
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
                name="desc"
                placeholder="Description"
            />
        </div>

        <!-- Category Field -->
        <div class="mb-3">
            <select
                name="category"
                required
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm bg-white"
            >
                <option value="Cards">Cards</option>
                <option value="Graded">Graded</option>
                <option value="Booster Box">Booster Box</option>
                <option value="Collection Boxes">Collection Boxes</option>
            </select>
        </div>

        <!-- Price Paid -->
        <div class="mb-3">
            <input
                type="number"
                step="0.01"
                name="pricePaid"
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
                placeholder="Price Paid"
            />
        </div>

        <!-- Market Value -->
        <div>
            <input
                type="number"
                step="0.01"
                name="marketValue"
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm"
                placeholder="Market Value"
            />
        </div>
    </div>
    <% }) %>

    <!-- Submit & Back -->
    <div class="flex items-center gap-4">
        <button
            type="submit"
            class="bg-green-600 hover:bg-green-700 text-white font-medium px-4 py-2 rounded"
        >
            💾 Save All
        </button>
        <a href="/" class="text-sm text-gray-700 hover:text-gray-900 underline"
            >⬅ Back</a
        >
    </div>
</form>

<script src="/form.js"></script>
