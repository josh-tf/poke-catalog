<h1 class="text-3xl font-bold text-gray-800 tracking-wide mb-6">Add Details</h1>

<form method="POST" action="/bulk-add/save" class="space-y-6">
    <% files.forEach((file, idx) => { %>
    <div
        class="bulk-item border border-gray-300 rounded-2xl p-6 bg-white shadow font-pixel space-y-4"
    >
        <!-- Image -->
        <img
            src="/uploads/<%= file.name %>"
            alt="Uploaded image"
            class="w-auto max-h-40 object-contain border border-gray-200 rounded bg-gray-50"
        />

        <input type="hidden" name="image" value="/uploads/<%= file.name %>" />

        <!-- ID Field -->
        <div>
            <label class="block text-sm mb-1 font-semibold">Item ID</label>
            <input
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pokemon-electric id-input"
                name="id"
                placeholder="ID (e.g. sv1v-087)"
            />
            <div class="text-xs text-gray-500 mt-1 id-feedback"></div>
        </div>

        <!-- Title Field -->
        <div>
            <label class="block text-sm mb-1 font-semibold">Title</label>
            <input
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pokemon-fire title-input"
                name="title"
                placeholder="Title"
            />
        </div>

        <!-- Description Field -->
        <div>
            <label class="block text-sm mb-1 font-semibold">Description</label>
            <input
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pokemon-water"
                name="desc"
                placeholder="Description"
            />
        </div>

        <!-- Purchase Date -->
        <div>
            <label class="block text-sm mb-1 font-semibold"
                >Purchase Date</label
            >
            <input
                type="date"
                name="purchaseDate"
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pokemon-water"
            />
        </div>

        <!-- Condition -->
        <div>
            <label class="block text-sm mb-1 font-semibold">Condition</label>
            <select
                name="condition"
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-pokemon-water"
            >
                <option value="">(condition)</option>
                <option value="mint">Mint</option>
                <option value="used">Used</option>
                <option value="sealed">Sealed</option>
            </select>
        </div>

        <!-- Trade/Sale -->
        <div class="flex gap-4 items-center">
            <label class="flex items-center gap-2">
                <input type="checkbox" name="forTrade" class="h-4 w-4" /> For
                Trade
            </label>
            <label class="flex items-center gap-2">
                <input type="checkbox" name="forSale" class="h-4 w-4" /> For
                Sale
            </label>
        </div>

        <!-- Category Field -->
        <div>
            <label class="block text-sm mb-1 font-semibold">Category</label>
            <select
                name="category"
                required
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-pokemon-grass"
            >
                <% categories.forEach(cat => { %>
                <option value="<%= cat.id %>"><%= cat.label %></option>
                <% }) %>
            </select>
        </div>

        <!-- Subcategory Field -->
        <div>
            <label class="block text-sm mb-1 font-semibold">Subcategory</label>
            <select
                name="subcategory"
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-pokemon-grass"
            >
                <option value="">(none)</option>
                <% categories.forEach(cat => { %>
                <% if (cat.subcategories) { %>
                <optgroup label="<%= cat.label %>">
                    <% cat.subcategories.forEach(sub => { %>
                    <option value="<%= sub.id %>"><%= sub.label %></option>
                    <% }) %>
                </optgroup>
                <% } %>
                <% }) %>
            </select>
        </div>

        <!-- Price Paid -->
        <div>
            <label class="block text-sm mb-1 font-semibold">Price Paid</label>
            <input
                type="number"
                step="0.01"
                name="pricePaid"
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pokemon-fairy"
                placeholder="Price Paid"
            />
        </div>

        <!-- Market Value -->
        <div>
            <label class="block text-sm mb-1 font-semibold">Market Value</label>
            <input
                type="number"
                step="0.01"
                name="marketValue"
                class="w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-pokemon-dragon"
                placeholder="Market Value"
            />
        </div>
    </div>
    <% }) %>

    <!-- Submit & Back -->
    <div class="flex items-center gap-4 mt-4">
        <button
            type="submit"
            class="btn bg-pokemon-grass hover:bg-pokemon-grass/90 text-white font-pixel"
        >
            💾 Save All
        </button>
        <a
            href="/"
            class="btn bg-gray-300 hover:bg-gray-400 text-gray-800 font-pixel inline-block"
        >
            ⬅ Back
        </a>
    </div>
</form>

<script src="/form.js"></script>
