<div class="max-w-3xl mx-auto p-6 bg-white rounded-xl shadow-md space-y-6">
    <h1 class="text-3xl font-bold text-gray-900"><%= item.title %></h1>

    <% if (item.images && item.images.length > 0) { %>
    <div class="flex flex-wrap gap-3">
        <% item.images.forEach(img => { %>
        <img
            src="<%= img %>"
            alt="Item image"
            class="h-48 rounded border border-gray-200 object-contain"
        />
        <% }) %>
    </div>
    <% } else { %>
    <p class="text-gray-500 italic">(no images)</p>
    <% } %>

    <div class="text-gray-800 space-y-4">
        <p>
            <span class="font-semibold">Category:</span>
            <%= item.category || '(none)' %>
        </p>

        <p>
            <span class="font-semibold">Description:</span>
            <%= item.desc?.trim() || '(none)' %>
        </p>

        <div>
            <span class="block font-semibold mb-1">Notes:</span>
            <div
                class="bg-yellow-100 border border-yellow-300 rounded p-3 shadow-inner text-sm whitespace-pre-wrap min-h-[3rem]"
            >
                <%= item.notes?.trim() || '(none)' %>
            </div>
        </div>

        <p>
            <span class="font-semibold">Flags:</span>
            <%= item.flags && item.flags.length ? item.flags.join(', ') : '(none)' %>
        </p>

        <p>
            <span class="font-semibold">Price Paid:</span>
            $<%= item.pricePaid ?? '(none)' %>
        </p>

        <p>
            <span class="font-semibold">Market Value:</span>
            $<%= item.marketValue ?? '(none)' %>
        </p>
    </div>

    <div class="flex flex-wrap gap-3 pt-6 border-t border-gray-200">
        <a
            href="/item/<%= item.id %>/edit"
            class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded shadow"
        >
            ✏️ Edit
        </a>

        <form
            method="POST"
            action="/item/<%= item.id %>/delete"
            onsubmit="return confirm('Delete item?');"
        >
            <button
                type="submit"
                class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded shadow"
            >
                🗑 Delete
            </button>
        </form>

        <a
            href="/"
            class="bg-gray-200 hover:bg-gray-300 text-gray-800 px-4 py-2 rounded shadow"
        >
            ⬅ Back
        </a>
    </div>
</div>
