<!DOCTYPE html>
<html>
  <head>
    <title><%= item.title %> - Details</title>
    <link href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.3/dist/lux/bootstrap.min.css" rel="stylesheet" />
  </head>
  <body class="p-4">
    <h1 class="mb-4"><%= item.title %></h1>
    <% if (item.images && item.images.length > 0) { %>
    <div class="mb-3 d-flex flex-wrap gap-2">
      <% item.images.forEach(img => { %>
      <img src="<%= img %>" class="img-thumbnail" style="max-height: 200px;" />
      <% }) %>
    </div>
    <% } %>
    <p><strong>Category:</strong> <%= item.category %></p>
    <% if (item.desc) { %><p><%= item.desc %></p><% } %>
    <% if (item.notes) { %><p><strong>Notes:</strong> <%= item.notes %></p><% } %>
    <p><strong>Price Paid:</strong> $<%= item.pricePaid %></p>
    <p><strong>Market Value:</strong> $<%= item.marketValue %></p>
    <div class="mt-3">
      <a class="btn btn-primary me-2" href="/item/<%= item.id %>/edit">✏️ Edit</a>
      <form method="POST" action="/item/<%= item.id %>/delete" style="display:inline;" onsubmit="return confirm('Delete item?');">
        <button class="btn btn-danger">🗑 Delete</button>
      </form>
      <a class="btn btn-secondary ms-2" href="/">⬅ Back</a>
    </div>
  </body>
</html>
