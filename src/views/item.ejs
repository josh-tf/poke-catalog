<div
    class="max-w-3xl mx-auto p-6 bg-white rounded-xl shadow-lg border-t-4 border-pokemon-electric space-y-6 font-pixel"
>
    <h1 class="text-3xl font-pixel text-pokemon-psychic mb-6 tracking-wide">
        <%= item.title %>
    </h1>

    <% if (item.images && item.images.length > 0) { %>
    <div class="flex flex-wrap gap-3">
        <% item.images.forEach(img => { %>
        <img
            src="<%= img %>"
            alt="Item image"
            class="h-48 rounded border border-gray-200 object-contain bg-gray-50"
            style="transform: scale(<%= user?.imageZoom || 1 %>)"
        />
        <% }) %>
    </div>
    <% } else { %>
    <p class="text-gray-400 italic">(no images)</p>
    <% } %>

    <div class="text-gray-800 space-y-4 text-sm leading-relaxed">
        <p>
            <span class="font-semibold text-pokemon-electric">Category:</span>
            <%= categories.find(c => c.id === item.category)?.label || '(none)' %>
            <% if (item.subcategory) { %>
            —
            <%= (() => {
  const cat = categories.find(c => c.subcategories?.some(s => s.id === item.subcategory));
  return cat?.subcategories?.find(s => s.id === item.subcategory)?.label || '';
})() %>
            <% } %>
        </p>

        <p>
            <span class="font-semibold text-pokemon-electric"
                >Description:</span
            >
            <%= item.desc?.trim() || '(none)' %>
        </p>

        <div>
            <span class="block font-semibold text-pokemon-electric mb-1"
                >Notes:</span
            >
            <%
  const notesContent = item.notes?.trim();
  const hasNotes = !!notesContent;
%>
            <div
                class="bg-yellow-100 border border-yellow-300 rounded-lg px-4 py-3 shadow-inner text-gray-700 text-sm leading-relaxed flex flex-col justify-start <%= hasNotes ? 'whitespace-pre-wrap' : 'whitespace-normal' %>"
                style="min-height: 3rem"
            >
                <%- notesContent || '(none)' %>
            </div>
        </div>

        <p>
            <span class="font-semibold text-pokemon-electric">Flags:</span>
            <%= item.flags?.length ? item.flags.join(', ') : '(none)' %>
        </p>

        <p>
            <span class="font-semibold text-pokemon-electric">Purchase Date:</span>
            <%= item.purchaseDate || '(unknown)' %>
        </p>

        <p>
            <span class="font-semibold text-pokemon-electric">Condition:</span>
            <%= item.condition || '(none)' %>
        </p>

        <p>
            <span class="font-semibold text-pokemon-electric">For Trade:</span>
            <%= item.forTrade ? 'Yes' : 'No' %>
        </p>

        <p>
            <span class="font-semibold text-pokemon-electric">For Sale:</span>
            <%= item.forSale ? 'Yes' : 'No' %>
        </p>

        <p>
            <span class="font-semibold text-pokemon-electric">Price Paid:</span>
            <%= typeof item.pricePaid === 'number' ? `$${item.pricePaid.toFixed(2)}` : '(none)' %>
        </p>

        <p>
            <span class="font-semibold text-pokemon-electric"
                >Market Value:</span
            >
            <%= typeof item.marketValue === 'number' ? `$${item.marketValue.toFixed(2)}` : '(none)' %>
        </p>
    </div>

    <div class="flex flex-wrap gap-3 pt-6 border-t border-gray-200">
        <a
            href="/item/<%= item.id %>/edit?returnTo=<%= encodeURIComponent(currentUrl) %>"
            class="bg-pokemon-water hover:bg-pokemon-water/90 text-white px-4 py-2 rounded shadow transition"
        >
            ✏️ Edit
        </a>

        <form
            method="POST"
            action="/item/<%= item.id %>/delete"
            onsubmit="return confirm('Delete item?');"
        >
            <button
                type="submit"
                class="bg-pokemon-fire hover:bg-pokemon-fire/90 text-white px-4 py-2 rounded shadow transition"
            >
                🗑 Delete
            </button>
        </form>

        <a
            href="/"
            class="bg-gray-300 hover:bg-gray-400 text-gray-800 px-4 py-2 rounded shadow transition"
        >
            ⬅ Back
        </a>
    </div>
</div>
