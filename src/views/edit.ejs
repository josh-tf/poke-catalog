<div class="max-w-2xl mx-auto p-6 bg-white rounded-xl shadow-lg border-t-4 border-pokemon-electric">
  <h1 class="page-title">
    Edit Item
  </h1>

  <form method="POST" action="/item/<%= item.id %>/edit" enctype="multipart/form-data" class="space-y-5 font-pixel">
    <input type="hidden" name="returnTo" value="<%= returnTo %>" />

    <!-- Title -->
    <div>
      <label class="block text-sm mb-1 text-pokemon-electric">Title</label>
      <input
        type="text"
        name="title"
        value="<%= item.title %>"
        required
        class="form-control"
      />
    </div>

    <!-- Category -->
    <div>
      <label class="block text-sm mb-1 text-pokemon-electric">Category</label>
      <select
        name="category"
        required
        class="form-control"
      >
        <% categories.forEach(cat => { %>
          <option value="<%= cat.id %>" <%= item.category === cat.id ? 'selected' : '' %>><%= cat.label %></option>
        <% }) %>
      </select>
    </div>

    <!-- Subcategory -->
    <div>
      <label class="block text-sm mb-1 text-pokemon-electric">Subcategory</label>
      <select
        name="subcategory"
        class="form-control"
      >
        <option value="">(none)</option>
        <% categories.forEach(cat => { %>
          <% if (cat.subcategories) { %>
            <optgroup label="<%= cat.label %>">
              <% cat.subcategories.forEach(sub => { %>
                <option value="<%= sub.id %>" <%= item.subcategory === sub.id ? 'selected' : '' %>><%= sub.label %></option>
              <% }) %>
            </optgroup>
          <% } %>
        <% }) %>
      </select>
    </div>

    <!-- Description -->
    <div>
      <label class="block text-sm mb-1 text-pokemon-electric">Description</label>
      <input
        type="text"
        name="desc"
        value="<%= item.desc || '' %>"
        placeholder="Description"
        class="form-control"
      />
    </div>

    <!-- Notes -->
    <div>
      <label class="block text-sm mb-1 text-pokemon-electric">Notes</label>
      <input
        type="text"
        name="notes"
        value="<%= item.notes || '' %>"
        placeholder="Notes"
        class="form-control"
      />
    </div>

    <!-- Purchase Date -->
    <div>
      <label class="block text-sm mb-1 text-pokemon-electric">Purchase Date</label>
      <input
        type="date"
        name="purchaseDate"
        value="<%= item.purchaseDate || '' %>"
        class="form-control"
      />
    </div>

    <!-- Condition -->
    <div>
      <label class="block text-sm mb-1 text-pokemon-electric">Condition</label>
      <select
        name="condition"
        class="form-control"
      >
        <option value="" <%= !item.condition ? 'selected' : '' %>>(condition)</option>
        <option value="mint" <%= item.condition === 'mint' ? 'selected' : '' %>>Mint</option>
        <option value="used" <%= item.condition === 'used' ? 'selected' : '' %>>Used</option>
        <option value="sealed" <%= item.condition === 'sealed' ? 'selected' : '' %>>Sealed</option>
      </select>
    </div>

    <!-- Trade/Sale -->
    <div class="flex gap-4 items-center text-sm">
      <label class="flex items-center gap-2">
        <input type="checkbox" name="forTrade" class="h-4 w-4" <%= item.forTrade ? 'checked' : '' %> /> For Trade
      </label>
      <label class="flex items-center gap-2">
        <input type="checkbox" name="forSale" class="h-4 w-4" <%= item.forSale ? 'checked' : '' %> /> For Sale
      </label>
    </div>

    <!-- Flags -->
    <div>
      <label class="block text-sm mb-1 text-pokemon-electric">Flags (comma separated)</label>
      <input
        type="text"
        name="flags"
        value="<%= item.flags ? item.flags.join(', ') : '' %>"
        placeholder="e.g. rare, sealed"
        class="form-control"
      />
    </div>

    <!-- Price Paid & Market Value -->
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm mb-1 text-pokemon-electric">Price Paid</label>
        <input
          type="number"
          step="0.01"
          name="pricePaid"
          value="<%= item.pricePaid %>"
          class="form-control"
        />
      </div>
      <div>
        <label class="block text-sm mb-1 text-pokemon-electric">Market Value</label>
        <input
          type="number"
          step="0.01"
          name="marketValue"
          value="<%= item.marketValue %>"
          class="form-control"
        />
      </div>
    </div>

    <!-- Existing Images -->
    <% if (item.images && item.images.length > 0) { %>
      <div>
        <p class="text-sm mb-2 text-pokemon-electric">Images</p>
        <div class="space-y-2">
          <% item.images.forEach(img => { %>
            <div class="flex items-center gap-3">
              <input
                type="checkbox"
                name="removeImages"
                value="<%= img %>"
                id="img-<%= Buffer.from(img).toString('base64') %>"
                class="h-4 w-4 text-pokemon-fire border-gray-300 rounded"
              />
              <label for="img-<%= Buffer.from(img).toString('base64') %>" class="flex items-center gap-3">
                <img src="<%= img %>" alt="Image" class="h-20 rounded border border-gray-200 bg-gray-50" />
                <span class="text-sm">Remove</span>
              </label>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>

    <!-- New Image Upload -->
    <div>
      <label class="block text-sm mb-1 text-pokemon-electric">Upload New Images</label>
      <input
        type="file"
        name="newImages"
        accept="image/*"
        multiple
        class="form-control"
      />
    </div>

    <!-- Buttons -->
    <div class="flex items-center gap-4 pt-2">
      <button
        type="submit"
        class="btn btn-primary"
      >
        💾 Save
      </button>
      <a
        href="/item/<%= item.id %>"
        class="btn btn-primary"
      >
        ⬅ Back
      </a>
    </div>
  </form>
</div>
