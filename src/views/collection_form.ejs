<h1 class="page-title">
    Create Collection
</h1>
<form method="POST" action="/collections/create" class="space-y-2">
    <input
        type="text"
        name="name"
        placeholder="Name"
        class="form-control"
        required
    />
    <textarea
        name="description"
        placeholder="Description"
        class="form-control"
    ></textarea>
    <label class="flex items-center gap-2">
        <input type="checkbox" name="public" /> Public
    </label>
    <button class="btn btn-primary">Save</button>
</form>
