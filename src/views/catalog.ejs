<h1 class="text-3xl font-pixel text-pokemon-psychic mb-6 tracking-wide">
    Poké Catalog
</h1>

<!-- Action Bar -->
<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <!-- Left: Actions -->
    <div class="flex flex-wrap items-center gap-2">
        <a
            href="/add"
            class="bg-pokemon-fire hover:bg-pokemon-fire/90 text-white px-4 py-2 rounded text-sm font-pixel shadow transition"
        >
            ➕ Add New Item
        </a>
        <a
            href="/bulk-add"
            class="bg-pokemon-electric hover:bg-pokemon-electric/90 text-black px-4 py-2 rounded text-sm font-pixel shadow transition"
        >
            📥 Bulk Upload
        </a>
    </div>

    <!-- Middle: View Switch -->
    <div class="flex items-center gap-2">
        <a
            href="/catalog?view=list"
            class="border border-gray-400 text-gray-800 font-pixel px-4 py-2 rounded text-sm hover:bg-gray-200 transition"
        >
            List View
        </a>
        <a
            href="/catalog?view=grid"
            class="border border-gray-400 text-gray-800 font-pixel px-4 py-2 rounded text-sm hover:bg-gray-200 transition"
        >
            Grid View
        </a>
    </div>

    <!-- Right: Filters -->
    <form method="get" class="flex flex-wrap items-center gap-2">
        <input type="hidden" name="view" value="<%= view %>" />

        <select
            name="sort"
            onchange="this.form.submit()"
            class="text-sm px-3 py-2 border border-gray-300 rounded bg-white font-pixel text-gray-800"
        >
            <% if (sort === 'title') { %>
            <option value="title" selected>Title</option>
            <% } else { %>
            <option value="title">Title</option>
            <% } %>

            <% if (sort === 'pricePaid') { %>
            <option value="pricePaid" selected>Price Paid</option>
            <% } else { %>
            <option value="pricePaid">Price Paid</option>
            <% } %>

            <% if (sort === 'marketValue') { %>
            <option value="marketValue" selected>Market Value</option>
            <% } else { %>
            <option value="marketValue">Market Value</option>
            <% } %>
        </select>

        <select
            name="order"
            onchange="this.form.submit()"
            class="text-sm px-3 py-2 border border-gray-300 rounded bg-white font-pixel text-gray-800"
        >
            <% if (order === 'asc') { %>
            <option value="asc" selected>Asc</option>
            <% } else { %>
            <option value="asc">Asc</option>
            <% } %>

            <% if (order === 'desc') { %>
            <option value="desc" selected>Desc</option>
            <% } else { %>
            <option value="desc">Desc</option>
            <% } %>
        </select>

        <select
            name="category"
            onchange="this.form.submit()"
            class="text-sm px-3 py-2 border border-gray-300 rounded bg-white font-pixel text-gray-800"
        >
            <% if (!category) { %>
            <option value="" selected>All Categories</option>
            <% } else { %>
            <option value="">All Categories</option>
            <% } %>

            <% if (category === 'Cards') { %>
            <option value="Cards" selected>Cards</option>
            <% } else { %>
            <option value="Cards">Cards</option>
            <% } %>

            <% if (category === 'Graded') { %>
            <option value="Graded" selected>Graded</option>
            <% } else { %>
            <option value="Graded">Graded</option>
            <% } %>

            <% if (category === 'Booster Box') { %>
            <option value="Booster Box" selected>Booster Box</option>
            <% } else { %>
            <option value="Booster Box">Booster Box</option>
            <% } %>

            <% if (category === 'Collection Boxes') { %>
            <option value="Collection Boxes" selected>Collection Boxes</option>
            <% } else { %>
            <option value="Collection Boxes">Collection Boxes</option>
            <% } %>
        </select>
    </form>
</div>

<!-- Grid or List View -->
<% if (view === 'grid') { %>
<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
    <% items.forEach(item => { %>
    <div class="bg-white rounded shadow overflow-hidden">
        <% if (item.images?.length > 0) { %>
        <img
            src="<%= item.images[0] %>"
            alt="Item Image"
            class="w-full h-48 object-contain bg-gray-100"
        />
        <% } %>
        <div class="p-4">
            <h5 class="text-lg font-semibold">
                <a
                    href="/item/<%= item.id %>"
                    class="text-blue-600 hover:underline"
                    ><%= item.title %></a
                >
            </h5>
            <p class="text-sm text-gray-600"><%= item.category %></p>
        </div>
    </div>
    <% }) %>
</div>
<% } else { %>
<form method="GET" action="/bulk-edit" class="space-y-4 mb-6">
    <% items.forEach(item => { %>
    <div class="bg-white border border-gray-200 rounded px-4 py-3">
        <label class="flex items-center gap-4 w-full cursor-pointer">
            <!-- Checkbox -->
            <input
                type="checkbox"
                name="ids"
                value="<%= item.id %>"
                class="shrink-0 mt-1"
            />

            <!-- Image -->
            <% if (item.images?.length > 0) { %>
            <img
                src="<%= item.images[0] %>"
                alt="Card image"
                class="h-20 w-20 object-contain bg-gray-100 rounded border shrink-0"
            />
            <% } else { %>
            <div
                class="h-20 w-20 flex items-center justify-center bg-gray-100 text-gray-400 border rounded text-xs shrink-0"
            >
                No Image
            </div>
            <% } %>

            <!-- Content -->
            <div class="flex justify-between items-center flex-1">
                <!-- Left: Info -->
                <div>
                    <a
                        href="/item/<%= item.id %>"
                        class="block text-blue-600 font-medium hover:underline text-base"
                    >
                        <%= item.title %>
                    </a>
                    <div class="text-sm text-gray-600">
                        <%= item.category %> <% if (item.desc) { %> — <%=
                        item.desc %><% } %>
                    </div>
                    <div class="text-xs text-gray-500">
                        ID: <%= item.id %>, Flags: <%= Array.isArray(item.flags)
                        && item.flags.length > 0 ? item.flags.join(', ') :
                        'None' %>
                    </div>
                </div>

                <!-- Right: Price Info -->
                <div class="text-right text-sm text-gray-700 min-w-[120px]">
                    <div>
                        Paid:
                        <span class="font-medium">$<%= item.pricePaid %></span>
                    </div>
                    <div>
                        Market:
                        <span class="font-medium"
                            >$<%= item.marketValue %></span
                        >
                    </div>
                </div>
            </div>
        </label>
    </div>
    <% }) %>
    <button
        class="bg-yellow-500 text-white px-4 py-2 rounded hover:bg-yellow-600"
    >
        Bulk Edit
    </button>
</form>
<% } %>

<!-- Category Chart -->
<div class="mt-6 bg-white rounded shadow p-6">
    <h4 class="text-lg font-pixel text-pokemon-grass mb-3">
        Items by Category
    </h4>

    <div id="categoryChart" class="min-h-[250px]"></div>
</div>

<script type="application/json" id="category-data">
    <%- JSON.stringify(categoryData) %>
</script>

<script>
    const categoryData = JSON.parse(
        document.getElementById('category-data').textContent,
    );
    const labels = Object.keys(categoryData);
    const series = labels.map((l) => categoryData[l]);
    const options = {
        series: series,
        labels: labels,
        chart: {
            type: 'donut',
            height: 250,
            fontFamily: 'Plus Jakarta Sans, sans-serif',
        },
        dataLabels: { enabled: false },
        legend: { position: 'bottom' },
    };
    if (document.querySelector('#categoryChart')) {
        new ApexCharts(
            document.querySelector('#categoryChart'),
            options,
        ).render();
    }
</script>
