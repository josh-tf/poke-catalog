<h1 class="text-3xl font-pixel text-pokemon-psychic mb-6 tracking-wide">
    My Catalog
</h1>

<!-- Action Bar -->
<div class="mb-6 flex flex-wrap items-center justify-between gap-4">

    <!-- Left: Action Buttons -->
    <div class="flex flex-wrap items-center gap-2">
        <a
            href="/add"
            class="bg-pokemon-fire hover:bg-pokemon-fire/90 text-white px-4 py-2 rounded text-sm font-pixel shadow transition"
        >
            ➕ Add New Item
        </a>
        <a
            href="/bulk-add"
            class="bg-pokemon-electric hover:bg-pokemon-electric/90 text-black px-4 py-2 rounded text-sm font-pixel shadow transition"
        >
            📥 Bulk Upload
        </a>
    </div>

    <!-- Middle: View Options + Search -->
    <div class="flex flex-wrap items-center gap-2">
        <!-- View Toggle -->
        <a
            href="/catalog?view=list"
            class="border border-gray-400 text-gray-800 font-pixel px-4 py-2 rounded text-sm hover:bg-gray-200 transition"
        >
            List View
        </a>
        <a
            href="/catalog?view=grid"
            class="border border-gray-400 text-gray-800 font-pixel px-4 py-2 rounded text-sm hover:bg-gray-200 transition"
        >
            Grid View
        </a>

        <!-- Search Bar -->
        <input
            type="text"
            id="searchInput"
            placeholder="Search items..."
            class="text-sm px-3 py-2 border border-gray-300 rounded bg-white font-pixel text-gray-800 w-64"
        />
    </div>

    <!-- Right: Filters -->
    <form method="get" class="flex flex-wrap items-center gap-2">
        <input type="hidden" name="view" value="<%= view %>" />

        <!-- Sort Field -->
        <select
            name="sort"
            onchange="this.form.submit()"
            class="text-sm px-3 py-2 border border-gray-300 rounded bg-white font-pixel text-gray-800"
        >
            <option value="title" <%= sort === 'title' ? 'selected' : '' %>>Title</option>
            <option value="pricePaid" <%= sort === 'pricePaid' ? 'selected' : '' %>>Price Paid</option>
            <option value="marketValue" <%= sort === 'marketValue' ? 'selected' : '' %>>Market Value</option>
        </select>

        <!-- Order -->
        <select
            name="order"
            onchange="this.form.submit()"
            class="text-sm px-3 py-2 border border-gray-300 rounded bg-white font-pixel text-gray-800"
        >
            <option value="asc" <%= order === 'asc' ? 'selected' : '' %>>Asc</option>
            <option value="desc" <%= order === 'desc' ? 'selected' : '' %>>Desc</option>
        </select>

        <!-- Category Filter -->
        <select
            name="category"
            onchange="this.form.submit()"
            class="text-sm px-3 py-2 border border-gray-300 rounded bg-white font-pixel text-gray-800"
        >
            <option value="" <%= !category ? 'selected' : '' %>>All Categories</option>
            <% categories.forEach(cat => { %>
            <option value="<%= cat.id %>" <%= category === cat.id ? 'selected' : '' %>><%= cat.label %></option>
            <% }) %>
        </select>
    </form>
</div>

<!-- Grid or List View -->
<% if (view === 'grid') { %>
<div id="catalogGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
    <% items.forEach(item => { %>
    <div class="catalog-item bg-white rounded shadow overflow-hidden">
        <% if (item.images?.length > 0) { %>
        <img
            src="<%= item.images[0] %>"
            alt="Item Image"
            class="w-full h-48 object-contain bg-gray-100"
        />
        <% } %>
        <div class="p-4">
            <h5 class="text-lg font-semibold">
                <a
                    href="/item/<%= item.id %>"
                    class="text-blue-600 hover:underline"
                    ><%= item.title %></a
                >
            </h5>
            <p class="text-sm text-gray-600"><%= categories.find(c => c.id === item.category).label %></p>
        </div>
    </div>
    <% }) %>
</div>
<script>
  let searchInput = document.getElementById('searchInput');
  let allItems = Array.from(document.querySelectorAll('.catalog-item'));

  if (searchInput && allItems.length > 0) {
    searchInput.addEventListener('input', () => {
      const query = searchInput.value.toLowerCase();
    allItems.forEach(el => {
      const title = el.querySelector('a').textContent.toLowerCase();
      el.style.display = title.includes(query) ? '' : 'none';
    });
  });
}
</script>
<% } else { %>
<form method="GET" action="/bulk-edit" class="space-y-4 mb-6">
    <% items.forEach(item => { %>
    <div class="catalog-item bg-white border border-gray-200 rounded px-4 py-3">
        <label class="flex items-center gap-4 w-full cursor-pointer">
            <input type="checkbox" name="ids" value="<%= item.id %>" class="shrink-0 mt-1" />

            <% if (item.images?.length > 0) { %>
            <img src="<%= item.images[0] %>" alt="Card image" class="h-20 w-20 object-contain bg-gray-100 rounded border shrink-0" />
            <% } else { %>
            <div class="h-20 w-20 flex items-center justify-center bg-gray-100 text-gray-400 border rounded text-xs shrink-0">No Image</div>
            <% } %>

            <div class="flex justify-between items-center flex-1">
                <div>
                    <a href="/item/<%= item.id %>" class="block text-blue-600 font-medium hover:underline text-base"><%= item.title %></a>
                    <div class="text-sm text-gray-600"><%= categories.find(c => c.id === item.category).label %> <% if (item.desc) { %> — <%= item.desc %><% } %></div>
                    <div class="text-xs text-gray-500">ID: <%= item.id %>, Flags: <%= Array.isArray(item.flags) && item.flags.length > 0 ? item.flags.join(', ') : 'None' %></div>
                </div>
                <div class="text-right text-sm text-gray-700 min-w-[120px]">
                    <div>Paid: <span class="font-medium">$<%= item.pricePaid %></span></div>
                    <div>Market: <span class="font-medium">$<%= item.marketValue %></span></div>
                </div>
            </div>
        </label>
    </div>
    <% }) %>
    <button class="bg-yellow-500 text-white px-4 py-2 rounded hover:bg-yellow-600">Bulk Edit</button>
</form>

<script>
  searchInput.addEventListener('input', () => {
    const query = searchInput.value.toLowerCase();
    allItems.forEach(el => {
      const title = el.querySelector('a').textContent.toLowerCase();
      el.style.display = title.includes(query) ? '' : 'none';
    });
  });
</script>
<% } %>

<!-- Category Chart -->
<div class="mt-6 bg-white rounded shadow p-6">
    <h4 class="text-lg font-pixel text-pokemon-grass mb-3">Items by Category</h4>
    <div id="categoryChart" class="min-h-[250px]"></div>
</div>

<script type="application/json" id="category-data">
    <%- JSON.stringify(categoryData) %>
</script>
<script>
    const categoryData = JSON.parse(document.getElementById('category-data').textContent);
    const ids = Object.keys(categoryData);
    const labels = ids.map((id) => categories.find(c => c.id === id).label);
    const series = ids.map((id) => categoryData[id]);
    const options = {
        series: series,
        labels: labels,
        chart: {
            type: 'donut',
            height: 250,
            fontFamily: 'Plus Jakarta Sans, sans-serif',
        },
        dataLabels: { enabled: false },
        legend: { position: 'bottom' },
    };
    if (document.querySelector('#categoryChart')) {
        new ApexCharts(document.querySelector('#categoryChart'), options).render();
    }
</script>
