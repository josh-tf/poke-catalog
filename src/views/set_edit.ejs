<h1 class="text-3xl font-pixel text-pokemon-psychic mb-6 tracking-wide flex items-center gap-2">
    Edit Set - <%= set.name %>
    <span class="bg-gray-200 px-2 py-0.5 rounded text-xs"><%= set.code %></span>
</h1>
<form method="POST" action="/sets/<%= set.code %>/edit" class="space-y-2">
    <input type="hidden" name="returnTo" value="<%= returnTo %>" />
    <% const types = languageItemTypes[set.language]; %>
    <% types.forEach(t => { %>
    <label class="flex items-center gap-2">
        <input type="checkbox" name="items" value="<%= t %>" <%= progress[t] ? 'checked' : '' %> />
        <%= t %>
    </label>
    <% }) %>
    <button class="btn bg-blue-600 text-white">Save</button>
</form>
