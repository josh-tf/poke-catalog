<%- include('partials/header', { title: 'Bulk Edit', user }) %>
<h1 class="mb-4">Bulk Edit</h1>
<form method="POST" action="/bulk-edit">
  <% items.forEach(item => { %>
  <input type="hidden" name="ids" value="<%= item.id %>" />
  <% }) %>
  <div class="mb-2">
    <select class="form-select" name="category">
      <option value="">-- Change Category --</option>
      <option value="Cards">Cards</option>
      <option value="Graded">Graded</option>
      <option value="Boosters">Boosters</option>
      <option value="Collection Boxes">Collection Boxes</option>
    </select>
  </div>
  <button class="btn btn-success">Update Items</button>
</form>
<a class="btn btn-secondary mt-3" href="/">⬅ Back</a>
<%- include('partials/footer') %>
