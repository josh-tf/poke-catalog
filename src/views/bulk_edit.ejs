<h1 class="text-3xl font-pixel text-pokemon-psychic mb-6 tracking-wide">
    Bulk Edit
</h1>

<form method="POST" action="/bulk-edit" class="space-y-6 mb-10 font-pixel">
    <% items.forEach(item => { %>
    <input type="hidden" name="ids" value="<%= item.id %>" />
    <% }) %>

    <!-- Category Dropdown -->
    <div>
        <label
            for="category"
            class="block text-sm mb-2 text-pokemon-electric tracking-wide"
        >
            🔄 Update Category
        </label>
        <select
            id="category"
            name="category"
            class="w-full border border-gray-300 rounded px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-pokemon-grass"
        >
            <option value="">-- Change Category --</option>
            <option value="Cards">Cards</option>
            <option value="Graded">Graded</option>
            <option value="Booster Box">Booster Box</option>
            <option value="Collection Boxes">Collection Boxes</option>
        </select>
    </div>

    <!-- Submit + Back + Delete Buttons -->
    <div class="flex flex-wrap gap-3 mt-4">
        <button
            type="submit"
            name="action"
            value="update"
            class="bg-pokemon-grass hover:bg-pokemon-grass/90 text-white text-sm px-4 py-2 rounded shadow transition"
        >
            ✅ Update Items
        </button>

        <button
            type="submit"
            name="action"
            value="delete"
            class="bg-pokemon-fire hover:bg-pokemon-fire/90 text-white text-sm px-4 py-2 rounded shadow transition"
            onclick="return confirm('Are you sure you want to delete all selected items?')"
        >
            🗑️ Delete Items
        </button>

        <a
            href="/"
            class="bg-gray-300 hover:bg-gray-400 text-sm text-gray-800 px-4 py-2 rounded inline-block transition"
        >
            ⬅ Back
        </a>
    </div>
</form>
