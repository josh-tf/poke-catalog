<h1 class="page-title">
    Bulk Edit
</h1>

<form method="POST" action="/bulk-edit" class="space-y-6 mb-10 font-pixel">
    <% items.forEach(item => { %>
    <input type="hidden" name="ids" value="<%= item.id %>" />
    <% }) %>

    <!-- Category Dropdown -->
    <div>
        <label
            for="category"
            class="block text-sm mb-2 text-pokemon-electric tracking-wide"
        >
            🔄 Update Category
        </label>
        <select
            id="category"
            name="category"
            class="form-control"
        >
            <option value="">-- Change Category --</option>
            <% categories.forEach(cat => { %>
            <option value="<%= cat.id %>"><%= cat.label %></option>
            <% }) %>
        </select>
    </div>

    <!-- Subcategory Dropdown -->
    <div>
        <label
            for="subcategory"
            class="block text-sm mb-2 text-pokemon-electric tracking-wide"
        >
            🔄 Update Subcategory
        </label>
        <select
            id="subcategory"
            name="subcategory"
            class="form-control"
        >
            <option value="">-- Change Subcategory --</option>
            <% categories.forEach(cat => { %>
                <% if (cat.subcategories) { %>
                    <optgroup label="<%= cat.label %>">
                        <% cat.subcategories.forEach(sub => { %>
                            <option value="<%= sub.id %>"><%= sub.label %></option>
                        <% }) %>
                    </optgroup>
                <% } %>
            <% }) %>
        </select>
    </div>

    <!-- Submit + Back + Delete Buttons -->
    <div class="flex flex-wrap gap-3 mt-4">
        <button
            type="submit"
            name="action"
            value="update"
            class="btn btn-primary"
        >
            ✅ Update Items
        </button>

        <button
            type="submit"
            name="action"
            value="delete"
            class="btn btn-primary"
            onclick="return confirm('Are you sure you want to delete all selected items?')"
        >
            🗑️ Delete Items
        </button>

        <a
            href="/"
            class="btn btn-primary"
        >
            ⬅ Back
        </a>
    </div>
</form>
