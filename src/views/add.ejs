<h1 class="text-3xl font-pixel text-pokemon-psychic mb-6 tracking-wide">
    Add New Item
</h1>

<form
    method="POST"
    action="/add"
    enctype="multipart/form-data"
    class="space-y-5 mb-10"
>
    <!-- Card ID -->
    <div>
        <input
            id="id-input"
            name="id"
            placeholder="Card ID (e.g. sv1v-087)"
            required
            class="w-full border border-gray-300 rounded px-4 py-2 text-sm font-pixel focus:outline-none focus:ring-2 focus:ring-pokemon-electric"
        />
        <div class="text-xs text-gray-500 id-feedback mt-1 font-pixel"></div>
    </div>

    <!-- Category -->
    <div>
        <select
            name="category"
            required
            class="w-full border border-gray-300 rounded px-4 py-2 text-sm font-pixel bg-white focus:outline-none focus:ring-2 focus:ring-pokemon-grass"
        >
            <% categories.forEach(cat => { %>
            <option value="<%= cat.id %>"><%= cat.label %></option>
            <% }) %>
        </select>
    </div>

    <!-- Title -->
    <div>
        <input
            id="title-input"
            name="title"
            placeholder="Title"
            required
            class="w-full border border-gray-300 rounded px-4 py-2 text-sm font-pixel focus:outline-none focus:ring-2 focus:ring-pokemon-fire"
        />
    </div>

    <!-- Description -->
    <div>
        <input
            name="desc"
            placeholder="Description"
            class="w-full border border-gray-300 rounded px-4 py-2 text-sm font-pixel focus:outline-none focus:ring-2 focus:ring-pokemon-water"
        />
    </div>

    <!-- Notes -->
    <div>
        <input
            name="notes"
            placeholder="Notes"
            class="w-full border border-gray-300 rounded px-4 py-2 text-sm font-pixel focus:outline-none focus:ring-2 focus:ring-pokemon-psychic"
        />
    </div>

    <!-- Flags -->
    <div>
        <input
            name="flags"
            placeholder="Flags (comma separated)"
            class="w-full border border-gray-300 rounded px-4 py-2 text-sm font-pixel focus:outline-none focus:ring-2 focus:ring-pokemon-dark"
        />
    </div>

    <!-- Price Paid -->
    <div>
        <input
            name="pricePaid"
            type="number"
            step="0.01"
            placeholder="Price Paid"
            class="w-full border border-gray-300 rounded px-4 py-2 text-sm font-pixel focus:outline-none focus:ring-2 focus:ring-pokemon-fairy"
        />
    </div>

    <!-- Market Value -->
    <div>
        <input
            name="marketValue"
            type="number"
            step="0.01"
            placeholder="Market Value"
            class="w-full border border-gray-300 rounded px-4 py-2 text-sm font-pixel focus:outline-none focus:ring-2 focus:ring-pokemon-dragon"
        />
    </div>

    <!-- Image Upload -->
    <div>
        <input
            type="file"
            name="images"
            accept="image/*"
            multiple
            class="w-full border border-gray-300 rounded px-4 py-2 text-sm font-pixel file:mr-3 file:py-1 file:px-3 file:border file:rounded file:border-gray-300 file:bg-gray-100 file:text-sm file:text-gray-700 hover:file:bg-gray-200"
        />
    </div>

    <!-- Submit -->
    <div class="flex gap-3">
        <button
            type="submit"
            class="bg-pokemon-grass hover:bg-pokemon-grass/90 text-white text-sm font-pixel px-4 py-2 rounded shadow transition"
        >
            💾 Save
        </button>
        <a
            href="/"
            class="bg-gray-300 hover:bg-gray-400 text-sm text-gray-800 font-pixel px-4 py-2 rounded inline-block transition"
        >
            ⬅ Back
        </a>
    </div>
</form>

<script src="/form.js"></script>
