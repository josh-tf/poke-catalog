<h1 class="page-title">
    Add New Item
</h1>

<form
    method="POST"
    action="/add"
    enctype="multipart/form-data"
    class="space-y-5 mb-10"
>
    <!-- Card ID -->
    <div>
        <input
            id="id-input"
            name="id"
            placeholder="Item ID (e.g. sv1s-101-087 or violet-ex-starter-deck)"
            required
            class="form-control"
        />
        <div class="text-xs text-gray-500 id-feedback mt-1 font-pixel"></div>
    </div>

    <!-- Category -->
    <div>
        <select
            name="category"
            required
            class="form-control"
        >
            <% categories.forEach(cat => { %>
            <option value="<%= cat.id %>"><%= cat.label %></option>
            <% }) %>
        </select>
    </div>

    <!-- Subcategory -->
    <div>
        <select
            name="subcategory"
            class="form-control"
        >
            <option value="">(none)</option>
            <% categories.forEach(cat => { %>
            <% if (cat.subcategories) { %>
            <optgroup label="<%= cat.label %>">
                <% cat.subcategories.forEach(sub => { %>
                <option value="<%= sub.id %>"><%= sub.label %></option>
                <% }) %>
            </optgroup>
            <% } %>
            <% }) %>
        </select>
    </div>

    <!-- Title -->
    <div>
        <input
            id="title-input"
            name="title"
            placeholder="Title"
            required
            class="form-control"
        />
    </div>

    <!-- Description -->
    <div>
        <input
            name="desc"
            placeholder="Description"
            class="form-control"
        />
    </div>

    <!-- Notes -->
    <div>
        <input
            name="notes"
            placeholder="Notes"
            class="form-control"
        />
    </div>

    <!-- Purchase Date -->
    <div>
        <input
            type="date"
            name="purchaseDate"
            class="form-control"
        />
    </div>

    <!-- Condition -->
    <div>
        <select
            name="condition"
            class="form-control"
        >
            <option value="">(condition)</option>
            <option value="mint">Mint</option>
            <option value="used">Used</option>
            <option value="sealed">Sealed</option>
        </select>
    </div>

    <!-- Trade/Sale -->
    <div class="flex gap-4 items-center text-sm">
        <label class="flex items-center gap-2">
            <input type="checkbox" name="forTrade" class="h-4 w-4" /> For Trade
        </label>
        <label class="flex items-center gap-2">
            <input type="checkbox" name="forSale" class="h-4 w-4" /> For Sale
        </label>
    </div>

    <!-- Flags -->
    <div>
        <input
            name="flags"
            placeholder="Flags (comma separated)"
            class="form-control"
        />
    </div>

    <!-- Price Paid -->
    <div>
        <input
            name="pricePaid"
            type="number"
            step="0.01"
            placeholder="Price Paid"
            class="form-control"
        />
    </div>

    <!-- Market Value -->
    <div>
        <input
            name="marketValue"
            type="number"
            step="0.01"
            placeholder="Market Value"
            class="form-control"
        />
    </div>

    <!-- Image Upload -->
    <div>
        <input
            type="file"
            name="images"
            accept="image/*"
            multiple
            class="form-control"
        />
    </div>

    <!-- Submit -->
    <div class="flex gap-3">
        <button
            type="submit"
            class="btn btn-primary"
        >
            💾 Save
        </button>
        <a
            href="/"
            class="btn btn-primary"
        >
            ⬅ Back
        </a>
    </div>
</form>

<script src="/form.js"></script>
