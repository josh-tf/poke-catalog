<h1 class="text-3xl font-bold text-gray-800 tracking-wide mb-6">
    Add New Item
</h1>

<form
    method="POST"
    action="/add"
    enctype="multipart/form-data"
    class="space-y-6 mb-10 max-w-xl bg-white/50 z-10 relative p-6 rounded-2xl border shadow"
>
    <!-- Item ID -->
    <div>
        <label for="id-input" class="block mb-1 text-sm font-semibold"
            >Item ID</label
        >
        <input
            id="id-input"
            name="id"
            placeholder="e.g. sv1s-101-087 or violet-ex-starter-deck"
            required
            class="w-full border border-gray-300 rounded-lg px-4 py-2 text-sm font-pixel focus:outline-none focus:ring-2 focus:ring-pokemon-electric"
        />
        <div class="text-xs text-gray-500 id-feedback mt-1 font-pixel"></div>
    </div>

    <!-- Category -->
    <div>
        <label for="category" class="block mb-1 text-sm font-semibold"
            >Category</label
        >
        <select
            id="category"
            name="category"
            required
            class="w-full border border-gray-300 rounded-lg px-4 py-2 text-sm font-pixel bg-white focus:outline-none focus:ring-2 focus:ring-pokemon-grass"
        >
            <% categories.forEach(cat => { %>
            <option value="<%= cat.id %>"><%= cat.label %></option>
            <% }) %>
        </select>
    </div>

    <!-- Subcategory -->
    <div>
        <label for="subcategory" class="block mb-1 text-sm font-semibold"
            >Subcategory</label
        >
        <select
            id="subcategory"
            name="subcategory"
            class="w-full border border-gray-300 rounded-lg px-4 py-2 text-sm font-pixel bg-white focus:outline-none focus:ring-2 focus:ring-pokemon-grass"
        >
            <option value="">(none)</option>
            <% categories.forEach(cat => { %>
            <% if (cat.subcategories) { %>
            <optgroup label="<%= cat.label %>">
                <% cat.subcategories.forEach(sub => { %>
                <option value="<%= sub.id %>"><%= sub.label %></option>
                <% }) %>
            </optgroup>
            <% } %>
            <% }) %>
        </select>
    </div>

    <!-- Title -->
    <div>
        <label for="title-input" class="block mb-1 text-sm font-semibold"
            >Title</label
        >
        <input
            id="title-input"
            name="title"
            placeholder="Title"
            required
            class="w-full border border-gray-300 rounded-lg px-4 py-2 text-sm font-pixel focus:outline-none focus:ring-2 focus:ring-pokemon-fire"
        />
    </div>

    <!-- Description -->
    <div>
        <label class="block mb-1 text-sm font-semibold">Description</label>
        <input
            name="desc"
            placeholder="Description"
            class="w-full border border-gray-300 rounded-lg px-4 py-2 text-sm font-pixel focus:outline-none focus:ring-2 focus:ring-pokemon-water"
        />
    </div>

    <!-- Notes -->
    <div>
        <label class="block mb-1 text-sm font-semibold">Notes</label>
        <input
            name="notes"
            placeholder="Notes"
            class="w-full border border-gray-300 rounded-lg px-4 py-2 text-sm font-pixel focus:outline-none focus:ring-2 focus:ring-pokemon-psychic"
        />
    </div>

    <!-- Purchase Date -->
    <div>
        <label class="block mb-1 text-sm font-semibold">Purchase Date</label>
        <input
            type="date"
            name="purchaseDate"
            class="w-full border border-gray-300 rounded-lg px-4 py-2 text-sm font-pixel focus:outline-none focus:ring-2 focus:ring-pokemon-psychic"
        />
    </div>

    <!-- Condition -->
    <div>
        <label class="block mb-1 text-sm font-semibold">Condition</label>
        <select
            name="condition"
            class="w-full border border-gray-300 rounded-lg px-4 py-2 text-sm font-pixel bg-white focus:outline-none focus:ring-2 focus:ring-pokemon-psychic"
        >
            <option value="">(condition)</option>
            <option value="mint">Mint</option>
            <option value="used">Used</option>
            <option value="sealed">Sealed</option>
        </select>
    </div>

    <!-- Trade/Sale -->
    <div class="flex gap-4 items-center text-sm">
        <label class="flex items-center gap-2">
            <input type="checkbox" name="forTrade" class="h-4 w-4" /> For Trade
        </label>
        <label class="flex items-center gap-2">
            <input type="checkbox" name="forSale" class="h-4 w-4" /> For Sale
        </label>
    </div>

    <!-- Flags -->
    <div>
        <label class="block mb-1 text-sm font-semibold">Flags</label>
        <input
            name="flags"
            placeholder="Flags (comma separated)"
            class="w-full border border-gray-300 rounded-lg px-4 py-2 text-sm font-pixel focus:outline-none focus:ring-2 focus:ring-pokemon-dark"
        />
    </div>

    <!-- Price Paid -->
    <div>
        <label class="block mb-1 text-sm font-semibold">Price Paid</label>
        <input
            name="pricePaid"
            type="number"
            step="0.01"
            placeholder="Price Paid"
            class="w-full border border-gray-300 rounded-lg px-4 py-2 text-sm font-pixel focus:outline-none focus:ring-2 focus:ring-pokemon-fairy"
        />
    </div>

    <!-- Market Value -->
    <div>
        <label class="block mb-1 text-sm font-semibold">Market Value</label>
        <input
            name="marketValue"
            type="number"
            step="0.01"
            placeholder="Market Value"
            class="w-full border border-gray-300 rounded-lg px-4 py-2 text-sm font-pixel focus:outline-none focus:ring-2 focus:ring-pokemon-dragon"
        />
    </div>

    <!-- Image Upload -->
    <div>
        <label class="block mb-1 text-sm font-semibold">Upload Images</label>
        <input
            type="file"
            name="images"
            accept="image/*"
            multiple
            class="w-full border border-gray-300 rounded-lg px-4 py-2 text-sm font-pixel file:mr-3 file:py-1 file:px-3 file:border file:rounded file:border-gray-300 file:bg-gray-100 file:text-sm file:text-gray-700 hover:file:bg-gray-200"
        />
    </div>

    <!-- Submit -->
    <div class="flex gap-3">
        <button
            type="submit"
            class="btn bg-pokemon-grass hover:bg-pokemon-grass/90 text-white font-pixel"
        >
            💾 Save
        </button>
        <a
            href="/"
            class="btn bg-gray-300 hover:bg-gray-400 text-gray-800 font-pixel inline-block"
        >
            ⬅ Back
        </a>
    </div>
</form>

<script src="/form.js"></script>
