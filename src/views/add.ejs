<!DOCTYPE html>
<html>
    <head>
        <title>Add Poké Item</title>
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
            rel="stylesheet"
        />
    </head>
    <body class="p-4">
        <h1 class="mb-4">Add New Poké Item</h1>
        <form
            method="POST"
            action="/add"
            enctype="multipart/form-data"
            class="mb-3"
        >
            <div class="mb-2">
                <input
                    class="form-control"
                    name="id"
                    placeholder="Card ID (e.g. sv1v-087)"
                    required
                />
            </div>
            <div class="mb-2">
                <select class="form-select" name="category" required>
                    <option value="Cards">Cards</option>
                    <option value="Graded">Graded</option>
                    <option value="Boosters">Boosters</option>
                    <option value="Collection Boxes">Collection Boxes</option>
                </select>
            </div>
            <div class="mb-2">
                <input
                    class="form-control"
                    name="title"
                    placeholder="Title"
                    required
                />
            </div>
            <div class="mb-2">
                <input
                    class="form-control"
                    name="desc"
                    placeholder="Description"
                />
            </div>
            <div class="mb-2">
                <input class="form-control" name="notes" placeholder="Notes" />
            </div>
            <div class="mb-2">
                <input
                    class="form-control"
                    name="flags"
                    placeholder="Flags (comma separated)"
                />
            </div>
            <div class="mb-2">
                <input
                    class="form-control"
                    name="pricePaid"
                    type="number"
                    step="0.01"
                    placeholder="Price Paid"
                />
            </div>
            <div class="mb-2">
                <input
                    class="form-control"
                    name="marketValue"
                    type="number"
                    step="0.01"
                    placeholder="Market Value"
                />
            </div>
            <div class="mb-2">
                <input
                    class="form-control"
                    type="file"
                    name="images"
                    accept="image/*"
                    multiple
                />
            </div>
            <button class="btn btn-success">💾 Save</button>
        </form>
        <a class="btn btn-secondary" href="/">⬅ Back</a>
    </body>
</html>
