<h1 class="page-title">Edit Collection</h1>
<form method="POST" action="/collections/<%= collection.userId %>/<%= collection.slug %>/edit" class="space-y-2">
    <input type="text" name="name" value="<%= collection.name %>" class="form-control" required />
    <textarea name="description" class="form-control"><%= collection.description || '' %></textarea>
    <label class="flex items-center gap-2">
        <input type="checkbox" name="public" <%= collection.public ? 'checked' : '' %> /> Public
    </label>
    <h2 class="font-semibold mt-4">Items</h2>
    <div class="space-y-1">
        <% items.forEach(i => { %>
        <label class="flex items-center gap-2">
            <input type="checkbox" name="items" value="<%= i.id %>" <%= i.collectionId === collection.id ? 'checked' : '' %> />
            <%= i.title %>
        </label>
        <% }) %>
    </div>
    <button class="btn btn-primary">Save</button>
</form>
