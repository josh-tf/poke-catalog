<h1 class="page-title">
    Preferences
</h1>
<form method="POST" class="space-y-4 max-w-lg" enctype="application/x-www-form-urlencoded">
    <div>
        <label class="block text-sm mb-1">Display Name</label>
        <input type="text" name="displayName" value="<%= user.displayName || '' %>" class="form-control" />
    </div>
    <div>
        <label class="block text-sm mb-1">Avatar URL</label>
        <input type="text" name="avatarUrl" value="<%= user.avatarUrl || '' %>" class="form-control" />
    </div>
    <div>
        <label class="block text-sm mb-1">Profile Description</label>
        <textarea name="profileDesc" rows="3" class="form-control"><%= user.profileDesc || '' %></textarea>
    </div>
    <div>
        <label class="block text-sm mb-1">Profile Banner URL</label>
        <input type="text" name="profileBanner" value="<%= user.profileBanner || '' %>" class="form-control" />
    </div>
    <div>
        <label class="block text-sm mb-1">Tagline</label>
        <input type="text" name="tagline" value="<%= user.tagline || '' %>" class="form-control" />
    </div>
    <div>
        <label class="block text-sm mb-1">Image Zoom</label>
        <input type="number" step="0.1" min="0.5" max="3" name="imageZoom" value="<%= user.imageZoom || 1 %>" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
</form>
