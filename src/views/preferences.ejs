<h1 class="text-3xl font-bold text-gray-800 tracking-wide mb-6">Preferences</h1>

<form
    method="POST"
    class="space-y-6 max-w-xl border-gray-200 relative z-10 bg-white/50 p-6 rounded-2xl border shadow"
    enctype="application/x-www-form-urlencoded"
>
    <div>
        <label class="block text-sm mb-1 font-semibold">Display Name</label>
        <input
            type="text"
            name="displayName"
            value="<%= user.displayName || '' %>"
            class="w-full border border-gray-300 rounded-lg px-4 py-2 text-sm font-pixel focus:outline-none focus:ring-2 focus:ring-pokemon-electric"
        />
    </div>

    <div>
        <label class="block text-sm mb-1 font-semibold">Avatar URL</label>
        <input
            type="text"
            name="avatarUrl"
            value="<%= user.avatarUrl || '' %>"
            class="w-full border border-gray-300 rounded-lg px-4 py-2 text-sm font-pixel focus:outline-none focus:ring-2 focus:ring-pokemon-electric"
        />
    </div>

    <div>
        <label class="block text-sm mb-1 font-semibold"
            >Profile Description</label
        >
        <textarea
            name="profileDesc"
            rows="3"
            class="w-full border border-gray-300 rounded-lg px-4 py-2 text-sm font-pixel focus:outline-none focus:ring-2 focus:ring-pokemon-water"
        >
<%= user.profileDesc || '' %></textarea
        >
    </div>

    <div>
        <label class="block text-sm mb-1 font-semibold"
            >Profile Banner URL</label
        >
        <input
            type="text"
            name="profileBanner"
            value="<%= user.profileBanner || '' %>"
            class="w-full border border-gray-300 rounded-lg px-4 py-2 text-sm font-pixel focus:outline-none focus:ring-2 focus:ring-pokemon-water"
        />
    </div>

    <div>
        <label class="block text-sm mb-1 font-semibold">Tagline</label>
        <input
            type="text"
            name="tagline"
            value="<%= user.tagline || '' %>"
            class="w-full border border-gray-300 rounded-lg px-4 py-2 text-sm font-pixel focus:outline-none focus:ring-2 focus:ring-pokemon-psychic"
        />
    </div>

    <div>
        <label class="block text-sm mb-1 font-semibold">Image Zoom</label>
        <%
            // Match the dropdown values to the zoomClassMap keys from catalog.ejs
            const zoomOptions = [
                { value: '0.25', label: '0.25x' },
                { value: '0.5', label: '0.5x' },
                { value: '0.75', label: '0.75x' },
                { value: '1', label: '1x (Default)' },
                { value: '1.25', label: '1.25x' },
                { value: '1.5', label: '1.5x' },
                { value: '1.75', label: '1.75x' },
                { value: '2', label: '2x' },
                { value: '2.25', label: '2.25x' },
                { value: '2.5', label: '2.5x' },
                { value: '2.75', label: '2.75x' },
                { value: '3', label: '3x (Max)' }
            ];
            const imageZoom = String(
                Math.max(0.25, Math.min(Number(user?.imageZoom) || 1, 3))
            );
        %>
        <select
            name="imageZoom"
            class="w-full border border-gray-300 rounded-lg px-4 py-2 text-sm font-pixel focus:outline-none focus:ring-2 focus:ring-pokemon-fighting"
        >
            <% zoomOptions.forEach(opt => { %>
                <option value="<%= opt.value %>" <%= imageZoom === opt.value ? 'selected' : '' %>>
                    <%= opt.label %>
                </option>
            <% }) %>
        </select>
    </div>

    <button
        type="submit"
        class="btn bg-pokemon-grass hover:bg-pokemon-grass/90 text-white font-pixel"
    >
        💾 Save
    </button>
</form>
