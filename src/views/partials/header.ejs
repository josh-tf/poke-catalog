<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.3/dist/sketchy/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@2.44.0/tabler-icons.min.css" />
    <link rel="stylesheet" href="/assets/css/theme.css" />
  </head>
  <body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">Poké Catalog</a>
        <div class="d-flex align-items-center">
          <% if (user) { %>
            <span class="navbar-text me-2">Logged in as <%= user.username %></span>
            <% if (user.avatar) { %>
              <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" class="rounded-circle me-2" style="height:32px" />
            <% } %>
            <a class="btn btn-sm btn-secondary" href="/logout">Logout</a>
          <% } else { %>
            <a class="btn btn-sm btn-light" href="/login">Login with Discord</a>
          <% } %>
        </div>
      </div>
    </nav>
    <div class="container-fluid mt-3">
      <div class="row">
        <aside class="col-md-2 border-end mb-3">
          <!-- Sidebar placeholder -->
          <p>Sidebar</p>
        </aside>
        <main class="col-md-10">
