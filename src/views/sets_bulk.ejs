<div class="max-w-3xl mx-auto p-6 bg-white rounded-2xl shadow-lg border-t-4 border-pokemon-electric space-y-8 font-pixel">
  <div class="flex items-center justify-between">
    <h1 class="text-3xl text-pokemon-psychic tracking-wide flex items-center gap-2">
      Bulk Edit — <%= group.group %>
      <span class="bg-gray-200 text-gray-700 text-xs px-2 py-0.5 rounded"><%= group.code %></span>
    </h1>
    <a href="/sets/era/<%= group.slug %>" class="text-blue-600 hover:underline text-sm">&larr; Back</a>
  </div>

  <form method="POST" action="/sets/era/<%= group.slug %>/bulk-edit" class="space-y-6">
    <% group.sets.forEach(set => { const prog = progressMap[set.code] || {}; const types = languageItemTypes[set.language]; %>
      <fieldset class="border border-gray-300 rounded-xl px-4 py-3 bg-gray-50">
        <legend class="font-semibold flex items-center gap-2 text-lg mb-2">
          <%= set.name %>
          <span class="bg-gray-200 px-2 py-0.5 rounded text-xs"><%= set.code %></span>
        </legend>
        <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-2">
          <% types.forEach(t => { %>
            <label class="flex items-center gap-2">
              <input type="checkbox" name="<%= set.code %>" value="<%= t %>" <%= prog[t] ? 'checked' : '' %> class="h-4 w-4 text-pokemon-fire border-gray-300 rounded focus:ring-pokemon-fire"/>
              <%= t %>
            </label>
          <% }) %>
        </div>
      </fieldset>
    <% }) %>

    <div class="pt-4">
      <button class="btn bg-blue-600 hover:bg-blue-700 text-white font-semibold px-4 py-2 rounded shadow">
        💾 Save
      </button>
    </div>
  </form>
</div>
