<h1 class="text-3xl font-pixel text-pokemon-psychic mb-6 tracking-wide">
    <%= userProfile.username %>'s Profile
</h1>
<div class="mb-6">
    <% if (userProfile.avatar) { %>
    <img
        src="https://cdn.discordapp.com/avatars/<%= userProfile.id %>/<%= userProfile.avatar %>.png"
        alt="avatar"
        class="w-24 h-24 rounded-full"
    />
    <% } %>
</div>
<div class="mb-6">
    <h2 class="text-lg font-semibold mb-2">Comments</h2>
    <% if (comments.length === 0) { %>
    <p>No comments yet.</p>
    <% } else { %>
    <ul class="space-y-2">
        <% comments.forEach(c => { %>
        <li>
            <strong><%= c.commenter.username %>:</strong>
            <%= c.content %>
        </li>
        <% }) %>
    </ul>
    <% } %>
</div>
<div class="mb-6">
    <h2 class="text-lg font-semibold mb-2">Catalog Items</h2>
    <% if (items.length === 0) { %>
    <p>No items.</p>
    <% } else { %>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
        <% items.forEach(i => { %>
        <div>
            <% if (i.images && i.images.length > 0) { %>
            <img
                src="<%= i.images[0] %>"
                data-id="<%= i.id %>"
                class="w-full h-24 object-contain bg-gray-100 cursor-pointer item-thumb"
            />
            <% } else { %>
            <div
                data-id="<%= i.id %>"
                class="w-full h-24 flex items-center justify-center bg-gray-100 text-sm text-gray-500 cursor-pointer item-thumb"
            >
                No Image
            </div>
            <% } %>
            <p class="text-sm text-center mt-1"><%= i.title %></p>
        </div>
        <% }) %>
    </div>
    <script type="application/json" id="items-data">
        <%- JSON.stringify(items) %>
    </script>
    <div
        id="itemModal"
        class="fixed inset-0 bg-black/50 hidden items-center justify-center"
    >
        <div class="bg-white p-4 rounded shadow max-w-sm w-full">
            <h3 id="modalTitle" class="text-lg font-semibold mb-2"></h3>
            <p id="modalDesc" class="mb-2"></p>
            <div id="modalExtra" class="space-y-1 text-sm mb-2 hidden">
                <div>Paid: $<span id="modalPaid"></span></div>
                <div>Market: $<span id="modalMarket"></span></div>
                <a id="viewLink" href="#" class="text-blue-600 underline"
                    >View Item</a
                >
                <a
                    id="editLink"
                    href="#"
                    class="ml-2 text-blue-600 underline"
                    >Edit Item</a
                >
            </div>
            <button
                type="button"
                onclick="document.getElementById('itemModal').classList.add('hidden')"
                class="px-3 py-1 bg-gray-300 rounded"
            >
                Close
            </button>
        </div>
    </div>
    <script>
        const itemData = JSON.parse(
            document.getElementById('items-data').textContent,
        );
        const isOwner = <%= showAll ? 'true' : 'false' %>;
        document.querySelectorAll('.item-thumb').forEach((el) => {
            el.addEventListener('click', () => {
                const id = el.dataset.id;
                const item = itemData.find((i) => i.id === id);
                if (!item) return;
                document.getElementById('modalTitle').textContent = item.title;
                document.getElementById('modalDesc').textContent = item.desc || '';
                if (isOwner) {
                    document.getElementById('modalPaid').textContent =
                        item.pricePaid || '';
                    document.getElementById('modalMarket').textContent =
                        item.marketValue || '';
                    document.getElementById('viewLink').href = '/item/' + item.id;
                    document.getElementById('editLink').href =
                        '/item/' + item.id + '/edit';
                    document.getElementById('modalExtra').classList.remove('hidden');
                } else {
                    document.getElementById('modalExtra').classList.add('hidden');
                }
                document
                    .getElementById('itemModal')
                    .classList.remove('hidden');
            });
        });
    </script>
    <% } %>
</div>
<div class="mb-6">
    <h2 class="text-lg font-semibold mb-2">Collections</h2>
    <% if (collections.length === 0) { %>
    <p>No collections.</p>
    <% } else { %>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        <% collections.forEach(c => { %>
        <div class="border rounded p-2 bg-white shadow">
            <div class="flex gap-1 mb-2">
                <% if (c.images && c.images.length > 0) { %>
                <% c.images.forEach(img => { %>
                <img src="<%= img %>" class="w-8 h-8 object-contain" />
                <% }) %>
                <% } %>
            </div>
            <h3 class="font-semibold">
                <a
                    href="/collections/<%= c.userId %>/<%= c.slug %>"
                    class="text-blue-600 hover:underline"
                    ><%= c.name %></a
                >
            </h3>
            <p class="text-sm">
                <%= c.itemCount %> items
                <% if (!c.public) { %>
                <span class="text-gray-500">(private)</span>
                <% } %>
            </p>
        </div>
        <% }) %>
    </div>
    <% } %>
</div>
<% if (user) { %>
<form
    method="POST"
    action="/user/<%= userProfile.id %>/comment"
    class="space-y-2"
>
    <textarea
        name="content"
        rows="3"
        class="w-full border p-2"
        required
    ></textarea>
    <button class="px-4 py-2 bg-blue-600 text-white rounded">
        Add Comment
    </button>
</form>
<% } %>
