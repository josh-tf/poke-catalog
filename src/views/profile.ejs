<div
    class="relative rounded-xl border border-gray-200 overflow-hidden bg-white/20 p-6 mb-8"
>
    <% if (userProfile.profileBanner) { %>
    <!-- Background image -->
    <div
        class="absolute inset-0 rounded-xl overflow-hidden z-0 pointer-events-none"
        style="
            background-image: url('<%= userProfile.profileBanner %>');
            background-size: cover;
            background-position: center;
        "
    ></div>

    <!-- Optional dark overlay -->
    <div class="absolute inset-0 bg-black/40 z-0 pointer-events-none"></div>
    <% } %>

    <!-- Foreground content -->
    <div class="relative z-10">
        <div
            class="flex flex-col md:flex-row items-center md:justify-between gap-6"
        >
            <div class="flex items-center gap-4">
                <% if (userProfile.avatarUrl || userProfile.avatar) { %>
                <div
                    class="w-20 h-20 rounded-full overflow-hidden border border-gray-200 border-gray-700"
                >
                    <img
                        src="<%= userProfile.avatarUrl || `https://cdn.discordapp.com/avatars/${userProfile.id}/${userProfile.avatar}.png` %>"
                        alt="avatar"
                        class="object-cover w-full h-full"
                    />
                </div>
                <% } %>
                <div>
                    <h1 class="text-2xl font-semibold text-white">
                        <%= userProfile.displayName || userProfile.username %>
                    </h1>
                    <% if (userProfile.tagline) { %>
                    <p class="text-sm italic text-gray-200">
                        <%= userProfile.tagline %>
                    </p>
                    <% } %>
                </div>
            </div>

            <button
                class="flex items-center gap-2 rounded-md border border-gray-100/50 bg-white/20 px-4 py-2 text-sm font-medium text-white shadow hover:bg-white/30 hover:text-pokemon-electric transition"
            >
                <i class="ti ti-edit"></i>
                Edit
            </button>
        </div>

        <% if (userProfile.profileDesc) { %>
        <p class="mt-6 text-sm text-gray-100 whitespace-pre-wrap">
            <%= userProfile.profileDesc %>
        </p>
        <% } %>
    </div>
</div>

<!-- Catalog Items -->
<div
    class="rounded-xl border border-gray-200 relative z-10 bg-white/50 p-6 mb-8"
>
    <div
        class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6"
    >
        <h2 class="text-lg font-semibold text-gray-800">Catalog Items</h2>
        <div class="flex flex-wrap gap-2">
            <input
                type="text"
                id="searchInput"
                placeholder="Search items..."
                class="border border-gray-200 bg-white text-sm rounded px-3 py-2 w-48 shadow-sm"
            />
            <select
                id="sortSelect"
                class="border border-gray-200 bg-white text-sm rounded px-3 py-2 shadow-sm"
            >
                <option value="recent" selected>Recently added</option>
                <option value="az">Name (A-Z)</option>
                <option value="za">Name (Z-A)</option>
            </select>
        </div>
    </div>

    <% if (items.length === 0) { %>
    <p class="text-sm text-gray-500">No items.</p>
    <% } else { %>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
        <% items.forEach(i => { %>
        <div
            class="border border-gray-200 rounded-xl border-gray-200 relative z-10 bg-white/50 p-4 shadow-sm cursor-pointer item-thumb"
            data-id="<%= i.id %>"
        >
            <% if (i.images && i.images.length > 0) { %>
            <div
                class="w-full h-24 mb-3 overflow-hidden rounded-md flex items-center justify-center"
            >
                <%
                    const scaleMap = {
                        0.5: 'scale-50',
                        0.75: 'scale-75',
                        1: 'scale-100',
                        1.25: 'scale-125',
                        1.5: 'scale-150',
                        1.75: 'scale-[1.75]',
                        2: 'scale-200',
                        2.5: 'scale-[2.5]',
                        3: 'scale-[3]',
                    };
                    const rawZoom = Math.max(0.5, Math.min(Number(user?.imageZoom) || 1, 3));
                    const scaleClass = scaleMap[rawZoom] || 'scale-100';
                    %>
                <img
                    src="<%= i.images[0] %>"
                    alt="<%= i.title %>"
                    class="object-contain max-h-full max-w-full <%= scaleClass %>"
                />
            </div>
            <% } else { %>
            <div
                class="w-full h-24 mb-3 rounded-md bg-white flex items-center justify-center text-sm text-gray-500"
            >
                No Image
            </div>
            <% } %>
            <h4 class="text-sm font-medium text-gray-800 truncate">
                <%= i.title %>
            </h4>
        </div>
        <% }) %>
    </div>
    <% } %>
</div>

<!-- Collections -->
<div
    class="rounded-xl border border-gray-200 relative z-10 bg-white/50 p-6 mb-8"
>
    <h2 class="text-lg font-semibold text-gray-800 mb-4">Collections</h2>
    <% if (collections.length === 0) { %>
    <p class="text-sm text-gray-500">No collections.</p>
    <% } else { %>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        <% collections.forEach(c => { %>
        <div
            class="border border-gray-200 border-gray-300 rounded-xl border-gray-200 relative z-10 bg-white/50 p-4 shadow-sm"
        >
            <% if (c.images && c.images.length > 0) { %>
            <div class="flex flex-wrap gap-2 mb-3">
                <% c.images.forEach(img => { %>
                <img
                    src="<%= img %>"
                    class="w-10 h-10 object-contain rounded-md bg-white p-1 shadow"
                />
                <% }) %>
            </div>
            <% } %>
            <h3 class="font-semibold text-gray-800 text-white">
                <a
                    href="/collections/<%= c.userId %>/<%= c.slug %>"
                    class="text-blue-600 text-blue-400 hover:underline"
                >
                    <%= c.name %>
                </a>
            </h3>
            <p class="text-sm text-gray-600 text-gray-400">
                <%= c.itemCount %> items <% if (!c.public) { %>
                <span class="text-gray-400">(private)</span>
                <% } %>
            </p>
        </div>
        <% }) %>
    </div>
    <% } %>
</div>

<!-- Comments Section -->
<% if (user) { %>
<form
    method="POST"
    action="/user/<%= userProfile.id %>/comment"
    class="rounded-xl border border-gray-200 relative z-10 bg-white/50 p-6 mb-6"
>
    <h2 class="text-lg font-semibold text-gray-800 mb-2">Leave a Comment</h2>
    <textarea
        name="content"
        rows="3"
        class="w-full border border-gray-200 relative z-10 bg-white/50 p-3 rounded-md text-sm text-gray-800 shadow-sm resize-none"
        required
    ></textarea>
    <button
        type="submit"
        class="mt-3 px-4 py-2 rounded-md bg-blue-600 text-white text-sm font-medium hover:bg-blue-700 shadow"
    >
        Add Comment
    </button>
</form>
<% } %>

<div class="rounded-xl border bg-white p-6 border-gray-200 mb-10">
    <h2 class="text-lg font-semibold text-gray-800 mb-4">Comments</h2>
    <% if (comments.length === 0) { %>
    <p class="text-sm text-gray-500">No comments yet.</p>
    <% } else { %>
    <ul class="space-y-4">
        <% comments.forEach(c => { %>
        <li
            class="border border-gray-200 border-gray-700 rounded-xl p-4 border-gray-200 relative z-10 bg-white/50 shadow-inner"
        >
            <div class="flex items-center gap-3 mb-2">
                <% if (c.commenter.avatarUrl || c.commenter.avatar) { %>
                <img
                    src="<%= c.commenter.avatarUrl || `https://cdn.discordapp.com/avatars/${c.commenter.id}/${c.commenter.avatar}.png` %>"
                    alt="avatar"
                    class="w-8 h-8 rounded-full ring-2 ring-pokemon-psychic"
                />
                <% } %>
                <span class="text-sm text-gray-600 text-gray-400">
                    <strong class="text-gray-800 text-white"
                        ><%= c.commenter.displayName || c.commenter.username
                        %></strong
                    >
                    said:
                </span>
            </div>
            <div
                class="bg-white bg-gray-800 border border-gray-200 border-gray-700 rounded-md p-3 text-sm text-gray-800 whitespace-pre-wrap shadow-sm"
            >
                <%= c.content %>
            </div>
        </li>
        <% }) %>
    </ul>
    <% } %>
</div>
