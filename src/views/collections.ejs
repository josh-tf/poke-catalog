<h1 class="text-3xl font-pixel text-pokemon-psychic mb-6 tracking-wide">
    My Collections
</h1>
<a
    href="/collections/create"
    class="bg-blue-600 text-white px-4 py-2 rounded mb-4 inline-block"
    >New Collection</a
>
<% if (collections.length === 0) { %>
<p>No collections yet.</p>
<% } else { %>
<ul class="space-y-2">
    <% collections.forEach(c => { %>
    <li>
        <a
            href="/collections/<%= c.userId %>/<%= c.slug %>"
            class="text-blue-600 hover:underline"
            ><%= c.name %></a
        >
        <% if (!c.public) { %><span class="text-sm text-gray-500"
            >(private)</span
        ><% } %>
    </li>
    <% }) %>
</ul>
<% } %>
