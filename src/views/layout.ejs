<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= typeof title !== 'undefined' ? title : 'Poké Catalog' %></title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://unpkg.com/@tabler/core@latest/dist/css/tabler.min.css" rel="stylesheet" />
    <link href="https://unpkg.com/@tabler/icons-webfont@latest/tabler-icons.min.css" rel="stylesheet" />
    <link href="/assets/css/style.css" rel="stylesheet" />
    <script src="https://unpkg.com/@tabler/core@latest/dist/js/tabler.min.js" defer></script>
    <script src="https://cdn.jsdelivr.net/npm/apexcharts" defer></script>
  </head>
  <body class="font-jakarta">
    <div class="page">
      <header class="navbar navbar-expand-md navbar-light d-print-none">
        <div class="container-xl">
          <h1 class="navbar-brand navbar-brand-autodark d-none-navbar-horizontal pe-0 pe-md-3">
            <a href="/">Poké Catalog</a>
          </h1>
          <div class="navbar-nav flex-row order-md-last">
            <% if (user) { %>
              <span class="nav-link d-none d-md-block">Logged in as <%= user.displayName || user.username %></span>
              <% if (user.avatarUrl || user.avatar) { %>
                <span class="nav-link pe-0"><img src="<%= user.avatarUrl || `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png` %>" class="avatar" /></span>
              <% } %>
              <a href="/logout" class="btn btn-danger btn-sm ms-2">Logout</a>
            <% } else { %>
              <a href="/login" class="btn btn-primary btn-sm">Login with Discord</a>
            <% } %>
          </div>
        </div>
      </header>

      <div class="page-wrapper">
        <aside class="navbar navbar-vertical navbar-expand-lg" data-bs-theme="dark">
          <div class="container-fluid">
            <div class="collapse navbar-collapse" id="sidebar-menu">
              <ul class="navbar-nav pt-lg-3">
                <li class="nav-item"><a class="nav-link" href="/"><i class="ti ti-home me-2"></i>Dashboard</a></li>
                <li class="nav-item"><a class="nav-link" href="/catalog"><i class="ti ti-book me-2"></i>Catalog</a></li>
                <li class="nav-item"><a class="nav-link" href="/collections"><i class="ti ti-archive me-2"></i>Collections</a></li>
                <li class="nav-item"><a class="nav-link" href="/sets"><i class="ti ti-cards me-2"></i>Sets</a></li>
                <li class="nav-item"><a class="nav-link" href="/add"><i class="ti ti-plus me-2"></i>Add Item</a></li>
                <li class="nav-item"><a class="nav-link" href="/user/<%= user ? user.id : '' %>"><i class="ti ti-user me-2"></i>Profile</a></li>
                <li class="nav-item"><a class="nav-link" href="/preferences"><i class="ti ti-settings me-2"></i>Preferences</a></li>
              </ul>
            </div>
          </div>
        </aside>

        <div class="page-body">
          <div class="container-xl">
            <%- body %>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
