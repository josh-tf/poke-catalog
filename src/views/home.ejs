<div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-800 tracking-wide mb-6">
        Social Feed
    </h1>

    <!-- Recent Collections -->
    <div
        class="relative z-10 rounded-xl border border-gray-200 bg-white/50 p-6 shadow-sm mb-6"
    >
        <h2 class="text-lg font-semibold text-gray-800 mb-4">
            Recent Collections
        </h2>
        <% if (collections.length === 0) { %>
        <p class="text-sm text-gray-500">No public collections yet.</p>
        <% } else { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
            <% collections.forEach(c => { %>
            <div
                class="border border-gray-200 rounded-xl p-4 bg-white shadow-sm"
            >
                <% if (c.thumbs && c.thumbs.length > 0) { %>
                <div class="flex flex-wrap gap-2 mb-3">
                    <% c.thumbs.forEach(t => { %>
                    <img
                        src="<%= t %>"
                        class="w-10 h-10 object-contain rounded-md bg-white p-1 shadow-sm"
                    />
                    <% }) %>
                </div>
                <% } %>
                <h3 class="font-semibold text-gray-800">
                    <a
                        href="/collections/<%= c.userId %>/<%= c.slug %>"
                        class="text-blue-600 hover:underline"
                    >
                        <%= c.name %>
                    </a>
                </h3>
                <p class="text-sm text-gray-500">by <%= c.user.username %></p>
            </div>
            <% }) %>
        </div>
        <% } %>
    </div>

    <!-- Top Users -->
    <div
        class="relative z-10 rounded-xl border border-gray-200 bg-white/50 p-6 shadow-sm mb-6"
    >
        <h2 class="text-lg font-semibold text-gray-800 mb-4">Top Users</h2>
        <div class="flex flex-wrap gap-4">
            <% topUsers.forEach(tu => { %>
            <a
                href="/user/<%= tu.user.id %>"
                class="flex items-center gap-3 text-gray-800 hover:text-blue-600"
            >
                <% if (tu.user.avatarUrl || tu.user.avatar) { %>
                <img
                    src="<%= tu.user.avatarUrl || `https://cdn.discordapp.com/avatars/${tu.user.id}/${tu.user.avatar}.png` %>"
                    class="w-8 h-8 rounded-full ring-1 ring-gray-300"
                />
                <% } %>
                <span class="text-sm font-medium"
                    ><%= tu.user.displayName || tu.user.username %></span
                >
            </a>
            <% }) %>
        </div>
    </div>

    <!-- Recent Users -->
    <div
        class="relative z-10 rounded-xl border border-gray-200 bg-white/50 p-6 shadow-sm mb-6"
    >
        <h2 class="text-lg font-semibold text-gray-800 mb-4">Recent Users</h2>
        <div class="flex flex-wrap gap-4">
            <% recentUsers.forEach(u => { %>
            <a
                href="/user/<%= u.id %>"
                class="flex items-center gap-3 text-gray-800 hover:text-blue-600"
            >
                <% if (u.avatarUrl || u.avatar) { %>
                <img
                    src="<%= u.avatarUrl || `https://cdn.discordapp.com/avatars/${u.id}/${u.avatar}.png` %>"
                    class="w-8 h-8 rounded-full ring-1 ring-gray-300"
                />
                <% } %>
                <span class="text-sm font-medium"
                    ><%= u.displayName || u.username %></span
                >
            </a>
            <% }) %>
        </div>
    </div>

    <!-- Stats -->
    <div
        class="relative z-10 rounded-xl border border-gray-200 bg-white/50 p-6 shadow-sm mb-6"
    >
        <h2 class="text-lg font-semibold text-gray-800 mb-4">Stats</h2>
        <ul class="space-y-1 text-sm text-gray-700">
            <li>
                Users:
                <%= stats.users %>
            </li>
            <li>
                Collections:
                <%= stats.collections %>
            </li>
            <li>
                Items:
                <%= stats.items %>
            </li>
        </ul>
    </div>
</div>
